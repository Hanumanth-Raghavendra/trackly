# Trackly configuration reference.
# Every value is an environment variable with a safe LOCAL default, so nothing here is required
# to run on your machine. In production (Render) the values come from render.yaml and the
# dashboard: see docs/DEPLOY.md. Never commit real secrets; .env files are git-ignored.

# --------------------------------------------------------------------------------------------
# Shared by core-api and insights
# --------------------------------------------------------------------------------------------

# One Postgres connection string for both services (Neon's works as-is). core-api also accepts
# JDBC_DATABASE_URL + DB_USERNAME + DB_PASSWORD instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trackly

# HS256 key that core-api signs access tokens with and insights verifies them with. 32+ chars.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me

# Shared secret for service-to-service calls (outbox nudge, reminder cron).
INTERNAL_SERVICE_TOKEN=dev-internal-token

# Web origins allowed to call the APIs, comma separated. The Android app's origins
# (https://localhost, capacitor://localhost) are always allowed in addition.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Max database connections per service (keep small on free plans).
DB_POOL_SIZE=5

# --------------------------------------------------------------------------------------------
# core-api (Spring Boot)
# --------------------------------------------------------------------------------------------

PORT=8080
# Where to send the "new events" nudge after each commit. Empty = insights relies on polling.
INSIGHTS_URL=http://localhost:4000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# true in production (HTTPS only). false locally so the cookie works on http://localhost.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
# One-click demo accounts, deleted after DEMO_TTL.
DEMO_ENABLED=true
DEMO_TTL=24h
OUTBOX_RETENTION_DAYS=30
RATE_LIMIT_ENABLED=true

# --------------------------------------------------------------------------------------------
# insights (Node)
# --------------------------------------------------------------------------------------------

# PORT=4000   (Render sets PORT itself; locally insights defaults to 4000)
LOG_LEVEL=info
REMINDERS_ENABLED=true
# Outbox polling: fast while someone is connected, slow when idle (core's nudge covers writes).
POLL_ACTIVE_MS=2000
POLL_IDLE_MS=1200000

# Optional AI. "none" (default) keeps everything rule-based and free.
#   gemini    -> AI_API_KEY from https://aistudio.google.com (free tier, no billing)
#   openai    -> any OpenAI-compatible API: set AI_BASE_URL (Groq, OpenRouter, Ollama, OpenAI)
#   anthropic -> Claude (paid)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Optional browser push (free). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --------------------------------------------------------------------------------------------
# Web app: see apps/web/.env.example (web) and apps/web/.env.mobile.example (Android)
# --------------------------------------------------------------------------------------------
