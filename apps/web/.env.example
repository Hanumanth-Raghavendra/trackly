# Web build (Vercel): leave the API URLs EMPTY. The browser calls /api/... on the same origin and
# vercel.json rewrites those paths to the Render services (keeps the refresh cookie first-party).
VITE_API_URL=
VITE_INSIGHTS_URL=

# Socket.IO can't go through Vercel rewrites, so it connects to the insights service directly.
# Local dev: leave empty (Vite proxies /socket.io). Production: https://<insights>.onrender.com
VITE_SOCKET_URL=

# Link shown on the landing page.
VITE_GITHUB_URL=https://github.com/Hanumanth-Raghavendra/trackly
