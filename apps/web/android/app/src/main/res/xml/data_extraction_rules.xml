<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the stored session (refresh token) out of cloud backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
